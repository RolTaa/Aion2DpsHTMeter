<Window x:Class="Aion2DpsHTMeter.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aion2DpsHTMeter.App.ViewModels"
        Title="Aion2DpsHTMeter"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextStrong}">

    <Window.Resources>
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>

        <Style x:Key="HideWhenEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PlayerRow" DataType="{x:Type vm:PlayerRowViewModel}">
            <Border x:Name="Row" BorderBrush="#8C000000" BorderThickness="0,0,0,1" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Class bar with the rank on it -->
                    <Border Grid.Column="0" Background="{Binding ClassBrush}">
                        <TextBlock Text="{Binding Rank}" FontFamily="{StaticResource NumberFont}" FontSize="12" FontWeight="Bold"
                                   Foreground="#0C0E14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <!-- DPS bar (3) with the name and the three values on top -->
                        <Grid Height="24">
                            <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding DpsBar, Mode=OneWay}" Foreground="{StaticResource DpsBar}" />
                            <DockPanel Margin="8,0" LastChildFill="True">
                                <DockPanel.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.8" Color="Black" />
                                </DockPanel.Effect>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DpsText}" FontFamily="{StaticResource NumberFont}" FontSize="12" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="{Binding HealText}" FontFamily="{StaticResource NumberFont}" FontSize="11" Foreground="{StaticResource HealText}" Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding TakenText}" FontFamily="{StaticResource NumberFont}" FontSize="11" Foreground="{StaticResource TakenText}" Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="White"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Grid>

                        <!-- Healing bar (1) -->
                        <ProgressBar Height="8" Style="{StaticResource MeterBar}" Value="{Binding HealBar, Mode=OneWay}" Foreground="{StaticResource HealBar}" />

                        <!-- Damage-taken bar (1) -->
                        <ProgressBar Height="8" Style="{StaticResource MeterBar}" Value="{Binding TakenBar, Mode=OneWay}" Foreground="{StaticResource TakenBar}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#12FFFFFF" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{Binding PanelBackground}" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8">
        <StackPanel>
            <!-- Header: boss, clock, buttons, HP, sort -->
            <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="12,10"
                    MouseLeftButtonDown="OnHeaderMouseDown">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Clock}" FontFamily="{StaticResource NumberFont}" FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,2,0" />
                            <Button x:Name="ClickThroughButton" Style="{StaticResource IconButton}" Click="OnClickThrough"
                                    ToolTip="クリックスルー切替(Ctrl+Shift+L)" AutomationProperties.Name="クリックスルー切替">
                                <Viewbox Width="14" Height="14">
                                    <Path Style="{StaticResource IconPath}" Data="M5,11 H19 V21 H5 Z M8,11 V7 A4,4 0 0 1 16,7 V11" Width="24" Height="24" />
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="OnReset" ToolTip="計測リセット" AutomationProperties.Name="計測リセット">
                                <Viewbox Width="14" Height="14">
                                    <Path Style="{StaticResource IconPath}" Data="M3,12 A9,9 0 1 0 6,5.3 M3,4 V9 H8" Width="24" Height="24" />
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButton}" IsEnabled="False" ToolTip="設定(未実装)" AutomationProperties.Name="設定">
                                <Viewbox Width="14" Height="14">
                                    <Path Style="{StaticResource IconPath}" Width="24" Height="24"
                                          Data="M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9 Z M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9" />
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="OnClose" ToolTip="終了" AutomationProperties.Name="終了">
                                <Viewbox Width="12" Height="12">
                                    <Path Style="{StaticResource IconPath}" Data="M6,6 L18,18 M18,6 L6,18" Width="24" Height="24" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="BOSS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BossName}" FontSize="14" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="170" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,6,0,0">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBoss}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding BossHpText}" FontFamily="{StaticResource NumberFont}" FontSize="11"
                                   Foreground="#C3C9D6" Margin="8,0,0,0" />
                        <ProgressBar Height="6" Style="{StaticResource MeterBar}" Value="{Binding BossHp, Mode=OneWay}"
                                     Foreground="#D9534F" Background="#1AFFFFFF" VerticalAlignment="Center" />
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Label Content="並び順" Target="{Binding ElementName=SortBox}" Foreground="{StaticResource TextMuted}" FontSize="11"
                               Padding="0" VerticalAlignment="Center" />
                        <ComboBox x:Name="SortBox" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" DisplayMemberPath="Label"
                                  MinWidth="140" Height="26" FontSize="12" Margin="8,0,0,0" />
                        <CheckBox Content="PTメンバーのみ" IsChecked="{Binding PartyOnly}" Foreground="{StaticResource TextMuted}"
                                  FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Status}" Style="{StaticResource HideWhenEmpty}" Margin="12,10" FontSize="12"
                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{Binding Players}" ItemTemplate="{StaticResource PlayerRow}" />

            <!-- Party totals -->
            <UniformGrid Columns="3" Background="#0AFFFFFF">
                <StackPanel Margin="12,8">
                    <TextBlock Text="DPS/合計ダメージ" FontSize="10" Foreground="{StaticResource TextMuted}" />
                    <TextBlock Text="{Binding TotalDps}" FontFamily="{StaticResource NumberFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DpsText}" />
                </StackPanel>
                <StackPanel Margin="12,8">
                    <TextBlock Text="PT合計 回復" FontSize="10" Foreground="{StaticResource TextMuted}" />
                    <TextBlock Text="{Binding TotalHeal}" FontFamily="{StaticResource NumberFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource HealText}" />
                </StackPanel>
                <StackPanel Margin="12,8">
                    <TextBlock Text="PT合計 被ダメ" FontSize="10" Foreground="{StaticResource TextMuted}" />
                    <TextBlock Text="{Binding TotalTaken}" FontFamily="{StaticResource NumberFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TakenText}" />
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
