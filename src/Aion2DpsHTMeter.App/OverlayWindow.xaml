<Window x:Class="Aion2DpsHTMeter.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aion2DpsHTMeter.App.ViewModels"
        Title="Aion2DpsHTMeter"
        Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextStrong}">

    <Window.Resources>
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>

        <!-- Header icon buttons, smaller than the shared ones to fit the narrow panel -->
        <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="3,0,0,0" />
        </Style>

        <Style x:Key="HideWhenEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
        One row, 20 px tall: the damage (16), healing (2) and damage-taken (2) bars stacked without gaps, and over the
        damage bar the name on the left and the values on the right, in one line.
        -->
        <DataTemplate x:Key="PlayerRow" DataType="{x:Type vm:PlayerRowViewModel}">
            <Border x:Name="Row" BorderBrush="#8C000000" BorderThickness="0,0,0,1" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Class bar with the rank on it -->
                    <Border Grid.Column="0" Background="{Binding ClassBrush}">
                        <TextBlock Text="{Binding Rank}" FontFamily="{StaticResource NumberFont}" FontSize="10" FontWeight="Bold"
                                   Foreground="#0C0E14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <Grid Height="16">
                            <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding DamageBar, Mode=OneWay}" Foreground="{StaticResource DpsBar}" />

                            <Grid Margin="4,0">
                            <Grid.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.9" Color="Black" />
                            </Grid.Effect>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DpsText}" Style="{StaticResource Number}" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="{Binding HealText}" Style="{StaticResource Number}" FontWeight="Bold" Foreground="{StaticResource HealText}" Margin="5,0,0,0" />
                                <TextBlock Text="{Binding TakenText}" Style="{StaticResource Number}" FontWeight="Bold" Foreground="{StaticResource TakenText}" Margin="5,0,0,0" />
                            </StackPanel>
                            </Grid>
                        </Grid>
                        <ProgressBar Height="2" Style="{StaticResource MeterBar}" Value="{Binding HealBar, Mode=OneWay}" Foreground="{StaticResource HealBar}" />
                        <ProgressBar Height="2" Style="{StaticResource MeterBar}" Value="{Binding TakenBar, Mode=OneWay}" Foreground="{StaticResource TakenBar}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#12FFFFFF" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{Binding PanelBackground}" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <!-- Header: boss and buttons, HP and kill time, sort and who is shown -->
            <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="6,5"
                    MouseLeftButtonDown="OnHeaderMouseDown">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ClickThroughButton" Style="{StaticResource SmallIconButton}" Click="OnClickThrough"
                                    ToolTip="クリックスルー切替(Ctrl+Shift+L)" AutomationProperties.Name="クリックスルー切替">
                                <Viewbox Width="10" Height="10">
                                    <Path Style="{StaticResource IconPath}" Data="M5,11 H19 V21 H5 Z M8,11 V7 A4,4 0 0 1 16,7 V11" Width="24" Height="24" />
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource SmallIconButton}" Click="OnReset" ToolTip="計測リセット" AutomationProperties.Name="計測リセット">
                                <Viewbox Width="10" Height="10">
                                    <Path Style="{StaticResource IconPath}" Data="M3,12 A9,9 0 1 0 6,5.3 M3,4 V9 H8" Width="24" Height="24" />
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource SmallIconButton}" Click="OnSettings" ToolTip="設定" AutomationProperties.Name="設定">
                                <Viewbox Width="10" Height="10">
                                    <Path Style="{StaticResource IconPath}" Width="24" Height="24"
                                          Data="M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9 Z M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9" />
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource SmallIconButton}" Click="OnClose" ToolTip="終了" AutomationProperties.Name="終了">
                                <Viewbox Width="9" Height="9">
                                    <Path Style="{StaticResource IconPath}" Data="M6,6 L18,18 M18,6 L6,18" Width="24" Height="24" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding BossName}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <DockPanel Margin="0,4,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                            <TextBlock Text="{Binding ClockLabel}" FontSize="9" Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Clock}" FontFamily="{StaticResource NumberFont}" FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding BossHpText}" Style="{StaticResource Number}"
                                   Foreground="#C3C9D6" Margin="4,0,0,0" />
                        <ProgressBar Height="4" Value="{Binding BossHp, Mode=OneWay}"
                                     Foreground="#D9534F" Background="#1AFFFFFF" VerticalAlignment="Center">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource MeterBar}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBoss}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </DockPanel>

                    <!-- Who is shown on the left, sort order on the right, half the width each -->
                    <UniformGrid Columns="2" Margin="0,4,0,0">
                        <Button Style="{StaticResource PillButton}" Content="{Binding ScopeLabel}" Click="OnNextScope"
                                Height="22" Padding="8,0" FontSize="10" Margin="0,0,2,0" HorizontalContentAlignment="Left"
                                ToolTip="表示する人: 周囲(全員)/ 個人(自分のみ)" AutomationProperties.Name="表示する人の切り替え" />
                        <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding Sort}" Height="22" FontSize="10" Margin="2,0,0,0"
                                  AutomationProperties.Name="並び順" ToolTip="並び順" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Status}" Style="{StaticResource HideWhenEmpty}" Margin="6,5" FontSize="10"
                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{Binding Players}" ItemTemplate="{StaticResource PlayerRow}" />

            <!-- Totals of the rows shown, one per line -->
            <Grid Background="#0AFFFFFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="合計 DPS/ダメージ" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="6,4,0,0" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalDps}" Style="{StaticResource Number}" FontWeight="Bold"
                           Foreground="{StaticResource DpsText}" Margin="0,4,6,0" />
                <TextBlock Grid.Row="1" Text="合計 回復" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="6,1,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalHeal}" Style="{StaticResource Number}" FontWeight="Bold"
                           Foreground="{StaticResource HealText}" Margin="0,1,6,0" />
                <TextBlock Grid.Row="2" Text="合計 被ダメ" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="6,1,0,4" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalTaken}" Style="{StaticResource Number}" FontWeight="Bold"
                           Foreground="{StaticResource TakenText}" Margin="0,1,6,4" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
