<Window x:Class="Aion2DpsHTMeter.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextStrong}">

    <Border Background="#F20C0E14" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8">
        <StackPanel>
            <DockPanel Background="#0AFFFFFF" MouseLeftButtonDown="OnHeaderMouseDown">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="0,8,10,8" Click="OnClose"
                        ToolTip="閉じる" AutomationProperties.Name="閉じる">
                    <Viewbox Width="12" Height="12">
                        <Path Data="M6,6 L18,18 M18,6 L6,18" Width="24" Height="24" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Viewbox>
                </Button>
                <TextBlock Text="設定" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0" />
            </DockPanel>

            <StackPanel Margin="14,12,14,16">
                <TextBlock Text="計測対象" FontSize="12" FontWeight="Bold" />
                <TextBlock Text="選んだ種類の相手との戦闘だけを表示します" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,8" />
                <WrapPanel>
                    <ToggleButton Style="{StaticResource PillToggle}" Content="アビスのアーティファクト" IsChecked="{Binding TargetArtifact}" Margin="0,0,6,6" />
                    <ToggleButton Style="{StaticResource PillToggle}" Content="ボス" IsChecked="{Binding TargetBoss}" Margin="0,0,6,6" />
                    <ToggleButton Style="{StaticResource PillToggle}" Content="雑魚" IsChecked="{Binding TargetTrash}" Margin="0,0,6,6" />
                </WrapPanel>

                <DockPanel Margin="0,14,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Opacity, StringFormat={}{0:P0}}" FontFamily="{StaticResource NumberFont}"
                               FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    <Label Content="背景の不透明度" Target="{Binding ElementName=OpacitySlider}" Foreground="{StaticResource TextStrong}"
                           FontSize="12" FontWeight="Bold" Padding="0" />
                </DockPanel>
                <Slider x:Name="OpacitySlider" Minimum="0.4" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                        Value="{Binding Opacity}" Margin="0,6,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
